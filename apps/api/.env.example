NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://sindikat:sindikat@127.0.0.1:5433/sindikat?schema=public
REDIS_URL=redis://localhost:6380
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000
S3_ENDPOINT=http://localhost:9010
S3_REGION=us-east-1
S3_ACCESS_KEY=sindikat
S3_SECRET_KEY=sindikat-secret
S3_BUCKET_MEDIA=sindikat-media
