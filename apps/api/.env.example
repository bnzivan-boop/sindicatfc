NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://sindikat:sindikat@127.0.0.1:5433/sindikat?schema=public
REDIS_URL=redis://localhost:6380
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000
S3_ENDPOINT=http://localhost:9010
S3_REGION=us-east-1
S3_ACCESS_KEY=sindikat
S3_SECRET_KEY=sindikat-secret
S3_BUCKET_MEDIA=sindikat-media
S3_BUCKET_PRIVATE=sindikat-private
# Каскад доставки кода: telegram,vk,sms (первый доставивший побеждает). В dev — console (код в лог).
OTP_CHANNELS=console
# Лимит кодов на номер в час (прод: 5; dev выше — для тестов)
OTP_MAX_PER_HOUR=30
# Telegram Gateway — https://gateway.telegram.org (токен из кабинета; sender — @username бренда, опционально)
TELEGRAM_GATEWAY_TOKEN=
TELEGRAM_GATEWAY_SENDER=
# VK ID — верификация номера сообщением ВКонтакте (endpoint и токен из кабинета VK ID)
VK_OTP_URL=
VK_OTP_TOKEN=
VK_OTP_TEMPLATE=
# SMS — запасной канал (пример SMS.ru)
SMS_URL=
SMS_API_KEY=
SMS_SENDER=
# демо-код входа для любого номера (только dev)
OTP_DEV_CODE=000000
