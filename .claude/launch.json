{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@sindikat/api", "start:dev"],
      "port": 3000
    },
    {
      "name": "mobile-web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@sindikat/mobile", "exec", "expo", "start", "--web", "--port", "8081"],
      "port": 8081
    },
    {
      "name": "web-cabinet",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@sindikat/web", "dev"],
      "port": 3001
    }
  ]
}
